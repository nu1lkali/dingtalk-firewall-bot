# ============================================================
# 旧版配置文件（仅用于首次启动时一次性迁移到 Web 配置中心）
# ============================================================
#
# 从 v2 开始，所有配置都由 Web 管理台维护，存放在 data/app.db。
# 首次启动时，本文件（以及 .env）中的阿里云 AK、实例列表、端口等信息
# 会被自动导入配置中心；导入之后本文件不再被读取，可以安全删除。
#
# 如需重新导入：删除 data/app.db 后重启服务。
# ------------------------------------------------------------

webhook:
  port: 5050
  secret_key: ""

cloud_providers:
  # 本平台核心：阿里云轻量应用服务器（SWAS）防火墙
  aliyun_lighthouse:
    enabled: true
    access_key_id: "${ALIYUN_ACCESS_KEY_ID}"
    access_key_secret: "${ALIYUN_ACCESS_KEY_SECRET}"
    region: "cn-hangzhou"
    type: "lighthouse"
    instances:
      - id: "your-instance-id"
        protocol: "tcp"
        ports: ["10000/65535"]
        description: "Home SWAS full access"
        ip_version: "auto"

  # 以下为旧版多云 provider，默认关闭（需自行安装对应 SDK）
  tencent:
    enabled: false
  aliyun:
    enabled: false
  aws:
    enabled: false
  huawei:
    enabled: false
  tencent_lighthouse:
    enabled: false
  aws_lightsail:
    enabled: false
  huawei_lighthouse:
    enabled: false

rules:
  auto_cleanup_old_ip: true
  max_rules_per_group: 100
  cleanup_days: 7
  ipv6_prefix: 128
  ipv4_prefix: 32
